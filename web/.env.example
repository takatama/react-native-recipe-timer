# Optional: copied to .env, loaded by the local Node server only.
# Never put API keys in VITE_* variables or browser storage.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
PORT=4317

# Per-process request cap, reset at UTC midnight or when the server restarts.
# This limits request count; it is not a monetary budget. No AI calls on startup.
AI_DAILY_REQUEST_LIMIT=50
